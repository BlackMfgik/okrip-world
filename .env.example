NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://okrip:local_only@localhost:5432/okrip
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace_with_a_random_secret_at_least_32_chars
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=http://localhost:3000/v1/auth/discord/callback
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=123456789012345678
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret_at_least_32_chars
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_USER_IDS=123456789,987654321
TELEGRAM_EXTRA_ADMIN_USER_IDS=
MINECRAFT_SERVER_ID=vanilla
MINECRAFT_SERVER_TOKEN=replace_with_a_random_secret_at_least_32_chars
# Temporary: allows repeated applications from the same Discord account.
APPLICATION_REPEAT_DEBUG=false
# true: a submitted nickname is approved immediately and whitelist_add is queued.
APPLICATION_AUTO_APPROVE=false
# Set on WEB service only; never prefix with NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:3001
# WEB only: internal Dynmap webserver on the Minecraft host (http://<ip>:<port>).
# Empty = the map page shows "unavailable".
DYNMAP_ORIGIN=
# WEB only: Dynmap of the Vanilla server (/map-vanilla). Empty = "unavailable".
DYNMAP_VANILLA_ORIGIN=

# Shared only by WEB server and API, for signed client IP rate-limit keys.
WEB_PROXY_SECRET=replace_with_another_random_secret_at_least_32_chars
