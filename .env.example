NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://okrip:local_only@localhost:5432/okrip
APP_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace_with_a_random_secret_at_least_32_chars
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace_me
DISCORD_REDIRECT_URI=http://localhost:3000/v1/auth/discord/callback
DISCORD_BOT_TOKEN=replace_me
DISCORD_GUILD_ID=123456789012345678
TELEGRAM_BOT_TOKEN=replace_me
